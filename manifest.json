{
  "manifest_version": 3,
  "name": "Readapt Lab",
  "version": "0.3.0",
  "description": "Персонализирует типографику и измеряет, как оформление влияет на чтение.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Readapt Lab",
    "default_popup": "popup.html"
  },
  "options_page": "welcome.html",
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
